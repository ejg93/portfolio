server.port=8080
cors.allowed-origins=http://localhost:3000,http://localhost:3100
logging.level.com.portfolio=DEBUG

# --- 필수 ---
anthropic.api.key=YOUR_ANTHROPIC_API_KEY
youtube.api.key=YOUR_YOUTUBE_API_KEY

# --- 선택 (미설정 시 해당 기능만 비활성) ---
kakao.rest.key=
saramin.access.key=

# AI 배틀 API. 인증이 없어서 켜 두면 아무나 호출해 모델 요금이 나간다
battle.enabled=false
battle.max-user-msg=2000
battle.max-history=10

# --- 청약 알리미 (datasource 셋이 비면 기동 실패. 로컬은 Docker Postgres — backend/CLAUDE.md 「로컬 실행」) ---
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.flyway.enabled=true
# 공공데이터포털 일반 인증키(Decoding). Encoding 키를 넣으면 이중 인코딩으로 인증 실패
data.go.kr.key=
# 수집 API 보호 토큰. 비면 POST /api/cheongyak/collect 가 503
cheongyak.collect.token=
cheongyak.applyhome.base-url=https://api.odcloud.kr/api/ApplyhomeInfoDetailSvc/v1
# 실행 한 번에 받는 공고문 수. 청약홈에는 1초 간격으로 요청한다
cheongyak.doc.batch-size=150
# 경쟁률·당첨가점을 받는 공고 수(APT 2콜·무순위 1콜), 지오코딩 공고 수, 실거래 API 호출 수 — 실행당 상한
cheongyak.result.batch-size=150
cheongyak.geo.batch-size=200
cheongyak.rtms.batch-size=300
# 시세 표본: 최근 N개월 실거래, 준공 N년 이내, 전용 ±N㎡. 지오코딩은 위 kakao.rest.key 를 쓴다(비면 건너뜀)
cheongyak.rtms.months=12
cheongyak.market.build-years=5
cheongyak.market.area-tolerance=5
